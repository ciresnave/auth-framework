    {
      "id": "sec-tokens-unguessable-and-unique",
      "rfc": "RFC 9635",
      "section": "11.8",
      "kind": "positive",
      "description": "Access tokens and continuation tokens are long random values and differ between requests.",
      "config": {
        "enabled": true,
        "transaction_endpoint": "/api/gnap/tx"
      },
      "client_key": "dpop",
      "steps": [
        {
          "do": "transaction",
          "proof": "valid",
          "request": {
            "access_token": {
              "access": [
                {
                  "type": "read"
                }
              ]
            }
          },
          "expect": {
            "outcome": "response",
            "assert": [
              {
                "path": "/access_token/value",
                "op": "min_length",
                "value": 32
              }
            ]
          },
          "save": {
            "at": {
              "pointer": "/access_token/value"
            },
            "ct": {
              "pointer": "/continue/access_token/value"
            }
          }
        },
        {
          "do": "transaction",
          "proof": "valid",
          "request": {
            "access_token": {
              "access": [
                {
                  "type": "read"
                }
              ]
            }
          },
          "expect": {
            "outcome": "response",
            "assert": [
              {
                "path": "/access_token/value",
                "op": "min_length",
                "value": 32
              },
              {
                "path": "/access_token/value",
                "op": "not_equals_saved",
                "value": "$at"
              },
              {
                "path": "/continue/access_token/value",
                "op": "not_equals_saved",
                "value": "$ct"
              }
            ]
          }
        }
      ]
    },
