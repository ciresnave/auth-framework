    {
      "id": "hash-rfc-example",
      "rfc": "RFC 9635",
      "section": "4.2.3",
      "kind": "positive",
      "description": "The interaction hash of the RFC's own example (four lines, SHA-256, URL-safe base64 without padding) comes out as the RFC states.",
