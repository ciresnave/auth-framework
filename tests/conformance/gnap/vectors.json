    {
      "id": "cont-after-approval",
      "rfc": "RFC 9635",
      "section": "5.1",
      "kind": "positive",
      "description": "After the resource owner approves, the client continues with the interaction reference, the interaction hash and a proof from its key, and receives an access token.",
      "config": {
        "enabled": true,
        "transaction_endpoint": "/api/gnap/tx",
        "interaction_base_url": "https://auth.example.test"
      },
      "client_key": "dpop",
      "steps": [
        {
          "do": "transaction",
          "proof": "valid",
          "request": {
            "access_token": {
              "access": [
                {
                  "type": "read"
                }
              ]
            },
            "interact": {
              "start": [
                "redirect"
              ],
              "finish": {
                "method": "redirect",
                "uri": "https://client.example.test/done",
                "nonce": "client-nonce-1"
              }
            }
          },
          "expect": {
            "outcome": "response",
            "assert": [
              {
                "path": "/interact/redirect",
                "op": "is_string"
              }
            ]
          },
          "save": {
            "tx": {
              "pointer": "/interact/redirect",
              "tail": true
            },
            "ct": {
              "pointer": "/continue/access_token/value"
            }
          }
        },
        {
          "do": "approve",
          "transaction": "$tx",
          "expect": {
            "outcome": "response"
          },
          "save": {
            "ref": {
              "pointer": "/interact_ref"
            },
            "hash": {
              "pointer": "/hash"
            }
          }
        },
        {
          "do": "continue",
          "transaction": "$tx",
          "token": "$ct",
          "interact_ref": "$ref",
          "interact_hash": "$hash",
          "proof": "valid",
          "expect": {
            "outcome": "response",
            "assert": [
              {
                "path": "/access_token/value",
                "op": "is_string"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "cont-pending-before-approval",
      "rfc": "RFC 9635",
      "section": "5.2",
      "kind": "positive",
      "description": "Continuing before the interaction is finished is answered with a new continuation token and no access token.",
      "config": {
        "enabled": true,
        "transaction_endpoint": "/api/gnap/tx",
        "interaction_base_url": "https://auth.example.test"
      },
      "client_key": "dpop",
      "steps": [
        {
          "do": "transaction",
          "proof": "valid",
          "request": {
            "access_token": {
              "access": [
                {
                  "type": "read"
                }
              ]
            },
            "interact": {
              "start": [
                "redirect"
              ],
              "finish": {
                "method": "redirect",
                "uri": "https://client.example.test/done",
                "nonce": "client-nonce-1"
              }
            }
          },
          "expect": {
            "outcome": "response",
            "assert": [
              {
                "path": "/interact/redirect",
                "op": "is_string"
              }
            ]
          },
          "save": {
            "tx": {
              "pointer": "/interact/redirect",
              "tail": true
            },
            "ct": {
              "pointer": "/continue/access_token/value"
            }
          }
        },
        {
          "do": "continue",
          "transaction": "$tx",
          "token": "$ct",
          "interact_ref": null,
          "interact_hash": null,
          "proof": "valid",
          "expect": {
            "outcome": "response",
            "assert": [
              {
                "path": "/access_token",
                "op": "absent"
              },
              {
                "path": "/continue/access_token/value",
                "op": "not_equals_saved",
                "value": "$ct"
              }
            ]
          }
        }
      ]
    },
