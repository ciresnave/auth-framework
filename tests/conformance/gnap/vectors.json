    {
      "id": "tok-rotate-replaces",
      "rfc": "RFC 9635",
      "section": "6.1",
      "kind": "positive",
      "description": "Rotating a token returns a new value with the same access rights; the old value stops being honoured and the new one is.",
      "config": {
        "enabled": true,
        "transaction_endpoint": "/api/gnap/tx"
      },
      "client_key": "dpop",
      "steps": [
        {
          "do": "transaction",
          "proof": "valid",
          "request": {
            "access_token": {
              "access": [
                {
                  "type": "read",
                  "actions": [
                    "list"
                  ]
                }
              ]
            }
          },
          "expect": {
            "outcome": "response"
          },
          "save": {
            "at": {
              "pointer": "/access_token/value"
            }
          }
        },
        {
          "do": "rotate",
          "token": "$at",
          "expect": {
            "outcome": "response",
            "assert": [
              {
                "path": "/value",
                "op": "not_equals_saved",
                "value": "$at"
              },
              {
                "path": "/access/0/type",
                "op": "equals",
                "value": "read"
              },
              {
                "path": "/access/0/actions/0",
                "op": "equals",
                "value": "list"
              }
            ]
          },
          "save": {
            "at2": {
              "pointer": "/value"
            }
          }
        },
        {
          "do": "introspect",
          "token": "$at",
          "expect": {
            "outcome": "response",
            "assert": [
              {
                "path": "/active",
                "op": "equals",
                "value": false
              }
            ]
          }
        },
        {
          "do": "introspect",
          "token": "$at2",
          "expect": {
            "outcome": "response",
            "assert": [
              {
                "path": "/active",
                "op": "equals",
                "value": true
              }
            ]
          }
        }
      ]
    },
